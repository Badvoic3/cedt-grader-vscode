{
  "name": "cedt-grader-submit",
  "displayName": "Grader Submit",
  "description": "%extension.description%",
  "version": "1.0.4",
  "publisher": "Badvoic3",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Badvoic3/cedt-grader-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Badvoic3/cedt-grader-vscode/issues"
  },
  "homepage": "https://github.com/Badvoic3/cedt-grader-vscode#readme",
  "qna": "https://github.com/Badvoic3/cedt-grader-vscode/issues",
  "galleryBanner": {
    "color": "#1d4fa8",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "type": "commonjs",
  "scripts": {
    "build": "tsc --noEmit -p . && node esbuild.mjs",
    "build:prod": "tsc --noEmit -p . && node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "test:watch": "vitest",
    "probe": "tsx scripts/probe.ts",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build:prod",
    "publish": "vsce publish --no-dependencies"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "fflate": "^0.8.3",
    "markdown-it": "^15.0.3",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.106.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "^4.10.38",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "main": "./dist/extension.js",
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "cafe-grader",
    "grader",
    "cedt",
    "competitive programming",
    "submit",
    "test cases",
    "Thai"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:python",
    "onLanguage:java",
    "onWebviewPanel:cedtGrader.statement",
    "onWebviewPanel:cedtGrader.tests"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "cedtGrader",
          "title": "%viewContainer.title%",
          "icon": "media/icon.svg"
        }
      ],
      "activitybar": [
        {
          "id": "cedtGrader",
          "title": "%viewContainer.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cedtGrader": [
        {
          "type": "webview",
          "id": "cedtGrader.panel",
          "name": "%view.name%",
          "icon": "media/icon.svg",
          "contextualTitle": "%view.contextualTitle%"
        }
      ]
    },
    "commands": [
      {
        "command": "cedtGrader.login",
        "title": "%command.login.title%",
        "category": "%command.category%",
        "icon": "$(sign-in)"
      },
      {
        "command": "cedtGrader.logout",
        "title": "%command.logout.title%",
        "category": "%command.category%",
        "icon": "$(sign-out)"
      },
      {
        "command": "cedtGrader.submit",
        "title": "%command.submit.title%",
        "category": "%command.category%"
      },
      {
        "command": "cedtGrader.chooseProblem",
        "title": "%command.chooseProblem.title%",
        "category": "%command.category%",
        "icon": "$(list-selection)"
      },
      {
        "command": "cedtGrader.showLastResult",
        "title": "%command.showLastResult.title%",
        "category": "%command.category%",
        "icon": "$(history)"
      },
      {
        "command": "cedtGrader.openStatement",
        "title": "%command.openStatement.title%",
        "category": "%command.category%",
        "icon": "$(file-pdf)"
      },
      {
        "command": "cedtGrader.refreshProblems",
        "title": "%command.refreshProblems.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "cedtGrader.testCrashReport",
        "title": "%command.testCrashReport.title%",
        "category": "%command.category%"
      },
      {
        "command": "cedtGrader.focus",
        "title": "%command.focus.title%",
        "category": "%command.category%",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "cedtGrader.openSettings",
        "title": "%command.openSettings.title%",
        "category": "%command.category%",
        "icon": "$(gear)"
      },
      {
        "command": "cedtGrader.showRequestLog",
        "title": "%command.showRequestLog.title%",
        "category": "%command.category%",
        "icon": "$(output)"
      },
      {
        "command": "cedtGrader.refreshHistory",
        "title": "%command.refreshHistory.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "cedtGrader.clearMapping",
        "title": "%command.clearMapping.title%",
        "category": "%command.category%",
        "icon": "$(close)"
      },
      {
        "command": "cedtGrader.downloadAttachment",
        "title": "%command.downloadAttachment.title%",
        "category": "%command.category%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "cedtGrader.openTests",
        "title": "%command.openTests.title%",
        "category": "%command.category%",
        "icon": "$(beaker)"
      },
      {
        "command": "cedtGrader.runTests",
        "title": "%command.runTests.title%",
        "category": "%command.category%",
        "icon": "$(play)"
      },
      {
        "command": "cedtGrader.toggleFolderMode",
        "title": "%command.toggleFolderMode.title%",
        "category": "%command.category%",
        "icon": "$(folder)"
      },
      {
        "command": "cedtGrader.renameFileToProblem",
        "title": "%command.renameFileToProblem.title%",
        "category": "%command.category%",
        "icon": "$(edit)"
      },
      {
        "command": "cedtGrader.loadTestcases",
        "title": "%command.loadTestcases.title%",
        "category": "%command.category%",
        "icon": "$(beaker)"
      },
      {
        "command": "cedtGrader.loadSampleCases",
        "title": "%command.loadSampleCases.title%",
        "category": "%command.category%",
        "icon": "$(file-pdf)"
      },
      {
        "command": "cedtGrader.clearCache",
        "title": "%command.clearCache.title%",
        "category": "%command.category%",
        "icon": "$(trash)"
      },
      {
        "command": "cedtGrader.cleanUpOldFiles",
        "title": "%command.cleanUpOldFiles.title%",
        "category": "%command.category%",
        "icon": "$(trash)"
      },
      {
        "command": "cedtGrader.openWalkthrough",
        "title": "%command.openWalkthrough.title%",
        "category": "%command.category%",
        "icon": "$(rocket)"
      },
      {
        "command": "cedtGrader.openTroubleshooting",
        "title": "%command.openTroubleshooting.title%",
        "category": "%command.category%",
        "icon": "$(question)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cedtGrader.showLastResult",
          "when": "view == cedtGrader.panel",
          "group": "navigation@1"
        },
        {
          "command": "cedtGrader.refreshProblems",
          "when": "view == cedtGrader.panel",
          "group": "navigation@2"
        },
        {
          "command": "cedtGrader.openSettings",
          "when": "view == cedtGrader.panel",
          "group": "navigation@3"
        },
        {
          "command": "cedtGrader.clearCache",
          "when": "view == cedtGrader.panel",
          "group": "9_data@1"
        },
        {
          "command": "cedtGrader.openWalkthrough",
          "when": "view == cedtGrader.panel",
          "group": "8_help@1"
        },
        {
          "command": "cedtGrader.openTroubleshooting",
          "when": "view == cedtGrader.panel",
          "group": "8_help@2"
        }
      ],
      "commandPalette": [
        {
          "command": "cedtGrader.focus"
        },
        {
          "command": "cedtGrader.testCrashReport",
          "when": "cedtGrader.devMode"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "cedtGrader.displayLanguage": {
          "type": "string",
          "default": "en",
          "enum": [
            "en",
            "th",
            "auto"
          ],
          "enumItemLabels": [
            "%config.displayLanguage.label.en%",
            "ไทย (Thai)",
            "%config.displayLanguage.label.auto%"
          ],
          "markdownDescription": "%config.displayLanguage.description%",
          "enumDescriptions": [
            "%config.displayLanguage.enum.en%",
            "%config.displayLanguage.enum.th%",
            "%config.displayLanguage.enum.auto%"
          ]
        },
        "cedtGrader.panel.sections": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "account",
              "current",
              "result",
              "history",
              "problems"
            ],
            "enumDescriptions": [
              "%config.panel.sections.account%",
              "%config.panel.sections.current%",
              "%config.panel.sections.result%",
              "%config.panel.sections.history%",
              "%config.panel.sections.problems%"
            ]
          },
          "default": [
            "account",
            "current",
            "result",
            "history",
            "problems"
          ],
          "markdownDescription": "%config.panel.sections.description%"
        },
        "cedtGrader.panel.compact": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.panel.compact.description%"
        },
        "cedtGrader.panel.openOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "%config.panelOpenOnStartup.description%"
        },
        "cedtGrader.panel.topicClickOrder": {
          "type": "string",
          "enum": [
            "showFirst",
            "hideFirst"
          ],
          "enumDescriptions": [
            "%config.panel.topicClickOrder.showFirst%",
            "%config.panel.topicClickOrder.hideFirst%"
          ],
          "default": "showFirst",
          "markdownDescription": "%config.panel.topicClickOrder.description%"
        },
        "cedtGrader.runner.defaultTimeLimitSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 0.1,
          "maximum": 60,
          "markdownDescription": "%config.runner.defaultTimeLimitSeconds.description%"
        },
        "cedtGrader.runner.defaultMemoryLimitMB": {
          "type": "number",
          "default": 1024,
          "minimum": 1,
          "markdownDescription": "%config.runner.defaultMemoryLimitMB.description%"
        },
        "cedtGrader.runner.compilerPaths": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "scope": "application",
          "markdownDescription": "%config.runner.compilerPaths.description%"
        },
        "cedtGrader.runner.extraCompileArgs": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope": "application",
          "markdownDescription": "%config.runner.extraCompileArgs.description%"
        },
        "cedtGrader.baseUrl": {
          "type": "string",
          "default": "https://cedt-grader.nattee.net",
          "scope": "application",
          "markdownDescription": "%config.baseUrl.description%"
        },
        "cedtGrader.username": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "%config.username.description%"
        },
        "cedtGrader.pollIntervalSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 3,
          "description": "%config.pollIntervalSeconds.description%"
        },
        "cedtGrader.confirmBeforeSubmit": {
          "type": "boolean",
          "default": true,
          "description": "%config.confirmBeforeSubmit.description%"
        },
        "cedtGrader.saveBeforeSubmit": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.saveBeforeSubmit.description%"
        },
        "cedtGrader.revealResultAfterSubmit": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.revealResultAfterSubmit.description%"
        },
        "cedtGrader.debugRequests": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.debugRequests.description%"
        },
        "cedtGrader.statementBeside": {
          "type": "boolean",
          "default": true,
          "description": "%config.statementBeside.description%"
        },
        "cedtGrader.explorer.badge": {
          "type": "string",
          "default": "score",
          "enum": [
            "score",
            "tag",
            "off"
          ],
          "enumDescriptions": [
            "%config.explorer.badge.score%",
            "%config.explorer.badge.tag%",
            "%config.explorer.badge.off%"
          ],
          "description": "%config.explorer.badge.description%"
        },
        "cedtGrader.explorer.colors": {
          "type": "boolean",
          "default": true,
          "description": "%config.explorer.colors.description%"
        },
        "cedtGrader.statementFollowsFile": {
          "type": "boolean",
          "default": true,
          "description": "%config.statementFollowsFile.description%"
        },
        "cedtGrader.defaultLanguage": {
          "type": "string",
          "default": "C++",
          "description": "%config.defaultLanguage.description%"
        },
        "cedtGrader.fileNamePattern": {
          "type": "string",
          "default": "{name}.{ext}",
          "markdownDescription": "%config.fileNamePattern.description%"
        },
        "cedtGrader.cacheMaxMB": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "markdownDescription": "%config.cacheMaxMB.description%"
        }
      }
    },
    "colors": [
      {
        "id": "cedtGrader.explorer.solved",
        "description": "%color.explorer.solved.description%",
        "defaults": { "dark": "charts.green", "light": "charts.green", "highContrast": "charts.green", "highContrastLight": "charts.green" }
      },
      {
        "id": "cedtGrader.explorer.inProgress",
        "description": "%color.explorer.inProgress.description%",
        "defaults": { "dark": "charts.yellow", "light": "charts.orange", "highContrast": "charts.yellow", "highContrastLight": "charts.orange" }
      },
      {
        "id": "cedtGrader.explorer.zero",
        "description": "%color.explorer.zero.description%",
        "defaults": { "dark": "charts.red", "light": "charts.red", "highContrast": "charts.red", "highContrastLight": "charts.red" }
      },
      {
        "id": "cedtGrader.explorer.untried",
        "description": "%color.explorer.untried.description%",
        "defaults": { "dark": "descriptionForeground", "light": "descriptionForeground", "highContrast": "descriptionForeground", "highContrastLight": "descriptionForeground" }
      },
      {
        "id": "cedtGrader.explorer.tag1",
        "description": "%color.explorer.tag.description%",
        "defaults": { "dark": "charts.blue", "light": "charts.blue", "highContrast": "charts.blue", "highContrastLight": "charts.blue" }
      },
      {
        "id": "cedtGrader.explorer.tag2",
        "description": "%color.explorer.tag.description%",
        "defaults": { "dark": "charts.purple", "light": "charts.purple", "highContrast": "charts.purple", "highContrastLight": "charts.purple" }
      },
      {
        "id": "cedtGrader.explorer.tag3",
        "description": "%color.explorer.tag.description%",
        "defaults": { "dark": "charts.orange", "light": "charts.orange", "highContrast": "charts.orange", "highContrastLight": "charts.orange" }
      },
      {
        "id": "cedtGrader.explorer.tag4",
        "description": "%color.explorer.tag.description%",
        "defaults": { "dark": "charts.yellow", "light": "charts.yellow", "highContrast": "charts.yellow", "highContrastLight": "charts.yellow" }
      },
      {
        "id": "cedtGrader.explorer.tag5",
        "description": "%color.explorer.tag.description%",
        "defaults": { "dark": "terminal.ansiCyan", "light": "terminal.ansiCyan", "highContrast": "terminal.ansiCyan", "highContrastLight": "terminal.ansiCyan" }
      },
      {
        "id": "cedtGrader.explorer.tag6",
        "description": "%color.explorer.tag.description%",
        "defaults": { "dark": "terminal.ansiMagenta", "light": "terminal.ansiMagenta", "highContrast": "terminal.ansiMagenta", "highContrastLight": "terminal.ansiMagenta" }
      }
    ],
    "walkthroughs": [
      {
        "id": "cedtGrader.start",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "openPanel",
            "title": "%walkthrough.openPanel.title%",
            "description": "%walkthrough.openPanel.description%",
            "media": {
              "markdown": "%walkthrough.openPanel.media%"
            },
            "completionEvents": [
              "onView:cedtGrader.panel"
            ]
          },
          {
            "id": "login",
            "title": "%walkthrough.login.title%",
            "description": "%walkthrough.login.description%",
            "media": {
              "markdown": "%walkthrough.login.media%"
            },
            "completionEvents": [
              "onContext:cedtGrader.loggedIn"
            ]
          },
          {
            "id": "openFile",
            "title": "%walkthrough.openFile.title%",
            "description": "%walkthrough.openFile.description%",
            "media": {
              "markdown": "%walkthrough.openFile.media%"
            },
            "completionEvents": [
              "onContext:cedtGrader.hasSourceFile"
            ]
          },
          {
            "id": "checkProblem",
            "title": "%walkthrough.checkProblem.title%",
            "description": "%walkthrough.checkProblem.description%",
            "media": {
              "markdown": "%walkthrough.checkProblem.media%"
            },
            "completionEvents": [
              "onContext:cedtGrader.hasProblem"
            ]
          },
          {
            "id": "submit",
            "title": "%walkthrough.submit.title%",
            "description": "%walkthrough.submit.description%",
            "media": {
              "markdown": "%walkthrough.submit.media%"
            },
            "completionEvents": [
              "onContext:cedtGrader.submitted"
            ]
          }
        ]
      }
    ]
  }
}
